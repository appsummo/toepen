# Copy to .env and fill in before running docker-compose.prod.yml.
# .env is git-ignored - never commit real values.

# Domain the site is served from. DNS must already point at this host, or
# Caddy cannot complete the Let's Encrypt challenge.
DOMAIN=toepen.example.com

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Database credentials. Generate a password, do not reuse one:
#   openssl rand -base64 24
POSTGRES_USER=toepen
POSTGRES_PASSWORD=
POSTGRES_DB=toepen

# Signing key for login tokens. Anyone who knows it can forge any account,
# so generate a long random value and keep it secret:
#   openssl rand -hex 32
JWT_SECRET=

# Extra browser origins allowed to call the API, comma separated. Leave empty
# when players use the site itself - it is same-origin and needs no entry.
CORS_ORIGINS=
