# Copy to .env and fill in before running docker-compose.prod.yml.
# .env is git-ignored - never commit real values.

# --- Only needed when running WITH the caddy profile (a box where ports 80 and
# --- 443 are free). On a host whose own nginx terminates TLS, leave both blank.
# Domain the site is served from. DNS must already point at this host, or Caddy
# cannot complete the Let's Encrypt challenge.
DOMAIN=
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Loopback port the web container is published on, for the host's nginx to
# proxy to. Change it only if 8080 is already taken on the host.
WEB_BIND_PORT=8080

# Proxies in front of the server, so rate limiting sees the real client IP.
# 1 = the host's own nginx (default), 2 = caddy -> nginx.
TRUST_PROXY_HOPS=1

# Database credentials. Generate a password, do not reuse one:
#   openssl rand -base64 24
POSTGRES_USER=toepen
POSTGRES_PASSWORD=
POSTGRES_DB=toepen

# Signing key for login tokens. Anyone who knows it can forge any account,
# so generate a long random value and keep it secret:
#   openssl rand -hex 32
JWT_SECRET=

# Extra browser origins allowed to call the API, comma separated. Leave empty
# when players use the site itself - it is same-origin and needs no entry.
CORS_ORIGINS=
